# Local development only. Real secrets live in the environment's secrets manager.
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
TIME_ZONE=America/Bogota
DATA_DIR=./data
DATABASE_URL=postgres://bulk_mailer:bulk_mailer_local@localhost:5432/bulk_mailer
# Integration tests drop and recreate this database's schema: never point it to a real database.
# Dev only: generate with `openssl rand -base64 32`. In real environments it comes from the secrets manager.
JWT_SIGNING_KEY=
# Non-production only: simulated Tayrona/SAP data, e.g. deploy/dev/fake-contracts.json
FAKE_CONTRACTS_FILE=deploy/dev/fake-contracts.json
# Sending: pause between sends, growing wait (base / Retry-After ceiling), archive copy address (bcc)
SEND_PAUSE_MS=1000
INCIDENT_BASE_WAIT_SECONDS=30
INCIDENT_MAX_WAIT_SECONDS=600
# ARCHIVE_COPY_ADDRESS=archivo@anutibara.com
# Upload budget per request (D48): files are streamed to <DATA_DIR>/.staging, never held in memory
UPLOAD_MAX_TOTAL_BYTES=209715200
UPLOAD_MAX_FILES=300
# Instance lease (D47): only its holder runs the background work; renewed every third of the TTL
INSTANCE_LEASE_TTL_SECONDS=30
# Operator abort of an execution (D32): allowed after this many minutes without progress, or at once with force
EXECUTION_ABORT_AFTER_MINUTES=10
# Shutdown (D33): seconds the job in progress may take to finish (the current send included) before the process
# exits; the container's grace period must be longer (e.g. docker compose stop_grace_period: 40s)
SHUTDOWN_TIMEOUT_SECONDS=25
# Delivery tracking (step 9): reconciliation of uncertain sends and sweep of unconfirmed ones
RECONCILE_DELAYS_MINUTES=5,15,60
RECONCILE_SWEEP_AFTER_HOURS=6
RECONCILE_SWEEP_MAX_HOURS=72
RECONCILE_SWEEP_INTERVAL_MINUTES=60
# Lookups per hourly sweep, those not looked up for the longest first (D44)
RECONCILE_SWEEP_BATCH_SIZE=50
# While a batch runs and this many minutes after, its sends are checked every DELIVERY_CHECK_INTERVAL_SECONDS (D21)
DELIVERY_CHECK_INTERVAL_SECONDS=60
DELIVERY_CHECK_TAIL_MINUTES=30
# Per-minute check budget (D38): sends looked up per check (oldest checked first), and checks a send is skipped after
# the logs API was unavailable for it
DELIVERY_CHECK_BATCH_SIZE=20
DELIVERY_CHECK_BACKOFF_CYCLES=2
# Receipt files (D41): sweep of files no receipt needs, and the minimum age before the sweep touches a file
FILE_ORPHAN_SWEEP_INTERVAL_MINUTES=360
FILE_ORPHAN_MIN_AGE_MINUTES=60
# ZeptoMail (EMAIL_PROVIDER=zeptomail; against the simulator: ZEPTOMAIL_BASE_URL=http://127.0.0.1:4002/v1.1,
# ZOHO_ACCOUNTS_URL=http://127.0.0.1:4002, OAuth dev-client/dev-secret/dev-refresh, ZEPTOMAIL_API_KEY=dev-key)
# ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
# ZEPTOMAIL_WEBHOOK_AUTH_HEADER=authorization
# WEBHOOK_MAX_SKEW_SECONDS=300
# Secrets: ZEPTOMAIL_API_KEY, ZOHO_OAUTH_CLIENT_ID, ZOHO_OAUTH_CLIENT_SECRET, ZOHO_OAUTH_REFRESH_TOKEN,
# ZEPTOMAIL_WEBHOOK_KEY, ZEPTOMAIL_WEBHOOK_AUTHORIZATION
# CORS (D49): exact origins of the web client, comma-separated (https://host[:port]); required in production, never *
# CORS_ALLOWED_ORIGINS=http://localhost:5173
# TLS is required in production:
# TLS_CERT_FILE=/path/cert.pem
# TLS_KEY_FILE=/path/key.pem
TEST_DATABASE_URL=postgres://bulk_mailer:bulk_mailer_local@localhost:5432/bulk_mailer_test
