{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "import",
    "vitest"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "no-console": "error",
    "typescript/no-explicit-any": "error",
    "import/no-cycle": "error",
    "import/no-unassigned-import": [
      "warn",
      {
        "allow": [
          "reflect-metadata"
        ]
      }
    ],
    "typescript/no-extraneous-class": [
      "warn",
      {
        "allowWithDecorator": true
      }
    ]
  },
  "ignorePatterns": [
    "dist",
    "node_modules",
    "coverage"
  ]
}
